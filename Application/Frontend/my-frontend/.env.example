# ============================================================
# GovConnect Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase (required for live data) ──────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Complaint AI Agent (Python FastAPI) ─────────────────────
# Run: python complaint_agent.py   (starts on port 5003)
VITE_AGENT_URL=http://localhost:5003

# ── STT Agent (Python FastAPI) ──────────────────────────────
# Run: python stt_agent.py         (starts on port 5002)
VITE_STT_AGENT_URL=http://localhost:5002

# ── Spring Boot backend (optional, for future integration) ──
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080

# ── App metadata ────────────────────────────────────────────
VITE_APP_NAME=GovConnect
VITE_APP_VERSION=1.0.0

# ── Feature flags ───────────────────────────────────────────
VITE_ENABLE_LIVE_TRANSCRIPT=true
VITE_ENABLE_AI_CATEGORIZE=true
VITE_ENABLE_WEBSOCKET_NOTIFICATIONS=false
