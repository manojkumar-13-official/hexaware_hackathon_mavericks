# ============================================================
# GovConnect Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# BACKEND_HOOK: Spring Boot API base URL
VITE_API_BASE_URL=http://localhost:8080/api

# WEBSOCKET_HOOK: Spring Boot WebSocket base URL
VITE_WS_URL=ws://localhost:8080

# AI_HOOK: AI microservice direct URL (if not proxied via Spring Boot)
VITE_AI_SERVICE_URL=http://localhost:8081

# App metadata
VITE_APP_NAME=GovConnect
VITE_APP_VERSION=1.0.0

# Feature flags (set to "true" to enable)
VITE_ENABLE_LIVE_TRANSCRIPT=false
VITE_ENABLE_AI_CATEGORIZE=false
VITE_ENABLE_WEBSOCKET_NOTIFICATIONS=false
